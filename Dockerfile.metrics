# Ізольоване середовище вимірювань (Лаб. 5): фіксовані ОС, Python та версії інструментів.
# Базовий образ закріплено за digest, інструменти ставляться лише з хешами (--require-hashes).
FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1

WORKDIR /work

COPY requirements-dev.txt .
RUN pip install --no-cache-dir --only-binary :all: --require-hashes -r requirements-dev.txt

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONHASHSEED=0 \
    LC_ALL=C.UTF-8

# Непривілейований користувач
RUN useradd --create-home metrics
USER metrics

CMD ["python", "--version"]
